 var import_teams = require("./teams");
 var import_team_validator = require("./team-validator");
 __reExport(sim_exports, require("../lib"), module.exports);
+// --- PATCH (ludex): esbuild's `__toCommonJS(sim_exports)` reassignment of
+// `module.exports` defines Battle/Dex/etc as GETTER-ONLY, NON-CONFIGURABLE
+// accessor properties (see `__copyProps` above: `__defProp(to, key, { get:
+// ..., enumerable: ... })` never sets `configurable: true`). That shape is
+// invisible to Node's static cjs-module-lexer, which backs the native
+// ESM/CJS interop used by `import { Dex } from "pokemon-showdown"` -- and
+// because the properties are non-configurable, they can't be redefined or
+// reassigned in place (an earlier version of this patch tried plain
+// `module.exports.Dex = ...` and threw `TypeError: Cannot set property Dex
+// of #<Object> which has only a getter`, since the file has "use strict").
+// Verified with cjs-module-lexer directly: it reports zero named exports
+// for the unpatched file. `require("pokemon-showdown")` and Vitest (which
+// uses its own permissive CJS/ESM interop, not cjs-module-lexer) never
+// surface the problem, which is why this was invisible until the seed CLI
+// ran for real under Node's ESM loader.
+// Fix: replace `module.exports` with a brand-new plain object. Object.assign
+// reads through the existing getters (real values, no conflict) and the
+// object-LITERAL keys below are exactly the syntactic pattern
+// cjs-module-lexer positively detects, restoring named-export interop.
+module.exports = Object.assign({}, module.exports, {
+  Battle: import_battle.Battle,
+  BattleStream: import_battle_stream.BattleStream,
+  Dex: import_dex.Dex,
+  PRNG: import_prng.PRNG,
+  Pokemon: import_pokemon.Pokemon,
+  Side: import_side.Side,
+  TeamValidator: import_team_validator.TeamValidator,
+  Teams: import_teams.Teams,
+  getPlayerStreams: import_battle_stream.getPlayerStreams,
+  toID: import_dex.toID
+});
+// --- PATCH (ludex): esbuild's `__toCommonJS(sim_exports)` reassignment of
+// `module.exports` is invisible to Node's static cjs-module-lexer, which
+// backs the native ESM/CJS interop used by `import { Dex } from
+// "pokemon-showdown"`. Verified with cjs-module-lexer directly: it reports
+// zero named exports for the unpatched file, so `import { Dex } from
+// "pokemon-showdown"` throws `SyntaxError: does not provide an export named
+// 'Dex'` under a real Node ESM loader (e.g. `tsx` in a "type": "module"
+// package), even though `require("pokemon-showdown")` works fine and Vitest
+// (which uses its own permissive CJS/ESM interop, not cjs-module-lexer)
+// never surfaces the problem. These plain assignments are the pattern
+// cjs-module-lexer positively detects, restoring named-export interop
+// without changing any real behavior (values are the same objects already
+// assigned above).
+module.exports.Battle = import_battle.Battle;
+module.exports.BattleStream = import_battle_stream.BattleStream;
+module.exports.Dex = import_dex.Dex;
+module.exports.PRNG = import_prng.PRNG;
+module.exports.Pokemon = import_pokemon.Pokemon;
+module.exports.Side = import_side.Side;
+module.exports.TeamValidator = import_team_validator.TeamValidator;
+module.exports.Teams = import_teams.Teams;
+module.exports.getPlayerStreams = import_battle_stream.getPlayerStreams;
+module.exports.toID = import_dex.toID;
