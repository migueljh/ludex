# Credenciales del Postgres que levanta docker-compose
POSTGRES_USER=ludex
POSTGRES_PASSWORD=ludex
POSTGRES_DB=ludex

# Unica fuente de conexion. La consumen dbmate y el seed.
DATABASE_URL=postgres://ludex:ludex@localhost:15432/ludex?sslmode=disable

# Puerto del server local de Showdown (profile "local", se usa desde la fase 2)
SHOWDOWN_LOCAL_PORT=8100

# --- Proveedores de LLM ---
# Solo el nombre de la variable se guarda en la base (tabla `providers`);
# el VALOR vive unicamente aca y en tu entorno. Nunca en la base, nunca en el
# codigo, nunca pegado en un chat con un agente.
# Configura solo las que vayas a usar.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Pool de rotacion: varias claves separadas por coma, para no cortar una
# corrida larga cuando una agota su cuota. Un 429 NO es un fallo del modelo:
# se rota a la siguiente y se reintenta el MISMO pedido.
GOOGLE_API_KEYS=

# Kimi / Moonshot (de pago) — proveedor alternativo, compatible con OpenAI.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1

# OpenCode Zen — plataforma aparte con sus propios creditos.
OPEN_CODE_ZEN_API_KEY=
OPEN_CODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPEN_CODE_ZEN_MODEL=claude-haiku-4-5

# Proveedor y modelo activos para el nodo `decide`.
LUDEX_PROVIDER=openai
LUDEX_MODEL=
